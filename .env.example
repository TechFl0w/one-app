# Copy to .env.local and fill in what you have. Lines left commented out stay off.

# Supabase project (Settings → API). Without these, every page shows the /demo salon.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Anthropic API key for the assistant (server-side only). Without it, the assistant says it isn't set up.
# ANTHROPIC_API_KEY=

# Background automations (server-only): Supabase secret key + a random secret Vercel Cron sends.
# SUPABASE_SECRET_KEY=sb_secret_xxx
# CRON_SECRET=

# Email (Resend). Without RESEND_API_KEY, emails are logged as skipped.
# RESEND_API_KEY=re_xxx
# RESEND_WEBHOOK_SECRET=whsec_xxx      # webhook for email.received → /api/webhooks/resend
# EMAIL_SEND_DOMAIN=mail.buildingwaves.tech
# EMAIL_INBOUND_DOMAIN=in.buildingwaves.tech

# Payments (Stripe Connect). Without these, bookings take no deposits.
# STRIPE_SECRET_KEY=sk_test_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx     # Connect webhook → /api/webhooks/stripe
# STRIPE_DEFAULT_COUNTRY=CA
# PLATFORM_FEE_PERCENT=0
# NEXT_PUBLIC_APP_URL=https://your-app.example
